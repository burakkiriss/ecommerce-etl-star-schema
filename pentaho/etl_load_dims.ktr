      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var quantity_clean;
var textMap = {
    "bir": 1, "iki": 2, "üç": 3, "uc": 3, "dört": 4, "dort": 4,
    "beş": 5, "bes": 5, "altı": 6, "alti": 6, "yedi": 7,
    "sekiz": 8, "dokuz": 9, "on": 10
};

var rawQty = quantity;

if (isNaN(rawQty)) {
    var key = rawQty.toString().toLowerCase().trim();
    if (textMap[key] != undefined) {
        quantity_clean = textMap[key];
    } else {
        quantity_clean = null;
    }
} else {
    quantity_clean = parseInt(rawQty);
}

if (quantity_clean != null &amp;&amp; quantity_clean &lt; 0) {
    quantity_clean = Math.abs(quantity_clean);
}
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>quantity_clean</name>
        <rename>quantity_clean</rename>
        <type>Integer</type>
        <length>10</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
