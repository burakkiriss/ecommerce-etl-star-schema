    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function fillIfEmpty(value, defaultValue) {
    if (value == null || value.toString().trim() == "") {
        return defaultValue;
    }
    return value;
}

var customer_email_final = fillIfEmpty(customer_email, "bilinmiyor@example.com");
var customer_city_final = fillIfEmpty(customer_city_clean, "Belirtilmemiş");
var shipping_city_final = fillIfEmpty(shipping_city_clean, "Belirtilmemiş");
var product_category_final = fillIfEmpty(product_category_clean, "Diğer");
var payment_method_final = fillIfEmpty(payment_method, "Belirtilmemiş");

</jsScript_script>
      </jsScript>
