  <step>
    <name>Fix_Date_Format</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function pad(n) {
    n = '' + n;
    return (n.length &lt; 2) ? '0' + n : n;
}

var order_date_clean;
var raw = order_date;

if (raw == null) {
    order_date_clean = null;
} else {
    raw = raw.toString().trim();

    var sep = null;
    if (raw.indexOf('/') >= 0) sep = '/';
    else if (raw.indexOf('.') >= 0) sep = '.';
    else if (raw.indexOf('-') >= 0) sep = '-';

    if (sep == null) {
        order_date_clean = raw;
    } else {
        var parts = raw.split(sep);
        if (parts.length != 3) {
            order_date_clean = raw;
        } else {
            var p0 = parts[0].trim(), p1 = parts[1].trim(), p2 = parts[2].trim();
            var year, month, day, found = false;

            if (p0.length == 4) {
                // YYYY-AY-GUN (ISO standardi)
                year = p0; month = parseInt(p1, 10); day = parseInt(p2, 10);
                found = true;
            } else if (p2.length == 4) {
                // GUN-AY-YYYY (Turk/Avrupa standardi)
                year = p2; day = parseInt(p0, 10); month = parseInt(p1, 10);
                found = true;
            }

            if (!found) {
                order_date_clean = raw; // yil hicbir kenarda yok, taninamadi
            } else {
                // Guvenlik kontrolu: "ay" 12'den buyuk cikarsa, gun/ay ters yazilmis demektir
                if (month > 12 &amp;&amp; day &lt;= 12) {
                    var tmp = month; month = day; day = tmp;
                }
                order_date_clean = year + '-' + pad(month) + '-' + pad(day);
            }
        }
    }
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>order_date_clean</name>
        <rename>order_date_clean</rename>
        <type>String</type>
        <length>10</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
