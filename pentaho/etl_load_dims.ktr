        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var unit_price_clean;
var rawPrice = unit_price;

if (isNaN(rawPrice)) {
    
    var cleaned = rawPrice.toString().replace(/[^0-9.,]/g, '').trim();
    
    cleaned = cleaned.replace(',', '.');
    unit_price_clean = parseFloat(cleaned);
} else {
    unit_price_clean = parseFloat(rawPrice);
}


if (!isNaN(unit_price_clean) &amp;&amp; unit_price_clean &lt; 0) {
    unit_price_clean = Math.abs(unit_price_clean);
}
</jsScript_script>
      </jsScript>
    </jsScripts>
