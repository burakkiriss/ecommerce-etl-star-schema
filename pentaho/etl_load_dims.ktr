        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>
var email = customer_email_final; 

if (email != null &amp;&amp; email.indexOf("_at_") >= 0) {
    email = email.replace(/_at_/g, "@");
}


var customer_email_fixed = email;</jsScript_script>
