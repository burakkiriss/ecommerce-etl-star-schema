  <step>
    <name>Fix_Text_Fields</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>function normalizeTR(str) {
    if (str == null) return null;
    var s = str.toString().trim().replace(/\s+/g, " ");
    if (s.length == 0) return null;

    // Once, harflere "yapismis" ayri Unicode aksan isaretlerini temizle
    // (ornek: "i" + ayri nokta isareti = gorunuste "i" ama aslinda 2 karakter)
    s = s.replace(/[\u0300-\u036f]/g, "");

    s = s
        .replace(/[çÇ]/g, "C")
        .replace(/[ğĞ]/g, "G")
        .replace(/[ıİIi]/g, "I")
        .replace(/[öÖ]/g, "O")
        .replace(/[şŞ]/g, "S")
        .replace(/[üÜ]/g, "U");

    return s.toUpperCase();
}

var customer_city_clean = normalizeTR(customer_city);
var shipping_city_clean = normalizeTR(shipping_city);
var product_category_clean = normalizeTR(product_category);</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>customer_city_clean</name>
        <rename>customer_city_clean</rename>
        <type>String</type>
        <length>50</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>shipping_city_clean</name>
        <rename>shipping_city_clean</rename>
